# =============================================================================
# MdH v2 — plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
#   cp .env.example .env
# `validateConfig()` (src/config.js) marcará faltantes al arrancar.
# =============================================================================

# --- GLPI -----------------------------------------------------------------
GLPI_BASE_URL=https://<glpi-host>/apirest.php
APP_TOKEN=
USER_TOKEN=
# IMPORTANTE: debe coincidir EXACTO con el campo `user_name` del /Log de GLPI,
# que viene con formato "nombre (id)" — p.ej. "glpi (2)" o "controles (1628)".
# Es el usuario dueño del USER_TOKEN/API. Si NO calza, glpiTicketSync descarta
# todo el log y NO entra ningún ticket nuevo al sistema (ver Troubleshooting §8).
GLPI_FILTER_USER=controles (1628)
# GLPI_TIMEOUT_MS=30000
# GLPI_RATE_LIMIT=10

# --- MySQL (persistencia) -------------------------------------------------
# Local/dev: motor en el mismo host o docker (127.0.0.1:3306).
# PRODUCCIÓN: motor EXTERNO (AWS RDS), accesible por red y con puerto que puede
# NO ser el estándar. Ejemplo real de prod:
#   DB_HOST=atena-tickets-prod-mariadb-incidents.<id>.us-east-1.rds.amazonaws.com
#   DB_PORT=5306
#   DB_USER=admin
# La base `mdh` debe existir vacía antes del primer arranque (ver README §4.2).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mdh
DB_PASS=
DB_NAME=mdh
# DB_POOL_LIMIT=10
# TLS hacia la BD. OBLIGATORIO en RDS con require_secure_transport=ON
# (error ER_SECURE_TRANSPORT_REQUIRED si no se activa):
# DB_SSL=true
# DB_SSL_CA=/home/<usuario>/MdH/certs/rds-combined-ca-bundle.pem   # opcional, para verificar el cert
# DB_SSL_REJECT_UNAUTHORIZED=true                                  # exige cert válido (requiere CA arriba)

# --- Aranda ASDK ----------------------------------------------------------
ARANDA_BASE_URL=https://<aranda-host>/ASDKAPI/api/v8.6
ARANDA_USERNAME=
ARANDA_PASSWORD=
ARANDA_AUTHOR_ID=
ARANDA_CATEGORY_ID=722
ARANDA_CUSTOMER_ID=5081
ARANDA_GROUP_ID=14
ARANDA_PROJECT_ID=1
ARANDA_REGISTRY_TYPE_ID=6
ARANDA_SERVICE_ID=551
ARANDA_SLA_ID=913
ARANDA_URGENCY_ID=3
ARANDA_COMPANY_ID=
ARANDA_RESPONSIBLE_ID=
# ARANDA_TIMEOUT_MS=30000
# ARANDA_RATE_LIMIT=5
# ARANDA_PULL_PAGE_SIZE=50

# --- Daemon ---------------------------------------------------------------
POLL_INTERVAL=20
# LOG_LEVEL=info        # debug|info|warn|error
# LOG_FORMAT=json       # json|pretty
# SERVICES_ENABLED=     # CSV vacío = todos los servicios habilitados
# RUN_MIGRATIONS_ON_START=true
# ANTI_ECHO_WINDOW_SECONDS=60
# Política GLPI-master: los casos se crean SOLO en GLPI. Un caso creado en Aranda NO se
# crea en GLPI. Por eso arandaTicketPull (creación inversa) está DESHABILITADO por defecto.
# Las actualizaciones Aranda→GLPI (notas/estados/soluciones/adjuntos) de casos originados
# en GLPI siguen activas. Cambiar a true SOLO para reactivar la creación de tickets desde Aranda.
# ARANDA_TICKET_PULL_ENABLED=false

# --- Reintentos / Circuit breaker -----------------------------------------
# RETRY_MAX_ATTEMPTS=5
# RETRY_BASE_MS=1000
# RETRY_MAX_MS=30000
# CIRCUIT_THRESHOLD=5
# CIRCUIT_RESET_MS=60000

# --- Salud ----------------------------------------------------------------
# HEALTH_FILE=state/health.json
